{
  "expo": {
    "name": "Irery",
    "slug": "irery",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0e27"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.anonymous.irery"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060e20"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.irery"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-av",
      "expo-web-browser"
    ]
  }
}
